# ==============================================================================
# EcoBite - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the variables below.
# NEVER commit your actual .env file or API keys to public source control.
# ==============================================================================

# --- AI Multimodal Vision Engine ---
# Obtain your Gemini API key from Google AI Studio (https://aistudio.google.com/)
# This key is strictly used on the backend and NEVER exposed to frontend JavaScript.
GEMINI_API_KEY=your_gemini_api_key_here

# Vision Model Configuration
# Supported options: gemini-2.0-flash (default, fast & accurate), gemini-1.5-flash, gemini-1.5-pro
ECOBITE_VISION_MODEL=gemini-2.0-flash

# --- Backend Application Settings ---
PORT=3000
SECRET_KEY=ecobite_secure_random_production_secret_key_change_me
FLASK_ENV=development
DEBUG=True
