# ==============================================================================
# EcoBite - Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the project root:
#   cp .env.example .env
# Then fill in your real Google Gemini API key below.
#
# NOTE: Never commit your actual .env file with private API keys to GitHub.
# ==============================================================================

# --- Google Gemini Vision AI API Configuration ---
# Obtain your free or paid Gemini API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Multimodal Vision Models:
# - gemini-2.0-flash (Recommended: fast, accurate, multimodal vision support)
# - gemini-1.5-flash (Standard lightweight multimodal vision)
# - gemini-1.5-pro   (High-detail multimodal reasoning)
GEMINI_MODEL=gemini-2.0-flash

# --- Server & Session Security ---
PORT=3000
SECRET_KEY=ecobite_secure_random_session_secret_key_change_in_production
FLASK_ENV=development
DEBUG=True
